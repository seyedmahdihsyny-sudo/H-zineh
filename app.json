{
  "expo": {
    "name": "H-zineh",
    "slug": "h-zineh",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.hzineh.expenses",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/hzineh-logo.png",
        "backgroundColor": "#090909"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "برای پیوست تصویر فاکتور به هزینه، دسترسی به تصاویر لازم است.",
          "cameraPermission": "برای ثبت تصویر فاکتور، دسترسی به دوربین لازم است."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#078577",
          "defaultChannel": "general"
        }
      ]
    ],
    "icon": "./assets/hzineh-logo.png"
  }
}